        "focus": [
          "feature_view",
          "viewmodel_hook",
          "domain_repo",
          "data_service",
          "api_service",
          "backend_api"
        ],
        "note": "Mandatory 5-layer isolation: View -> ViewModel (hook) -> Repository -> Service -> IApiService -> HTTP."
      },
      {
        "id": "edge_pbac_i18n",
        "label": "2. Edge Proxy, PBAC & RTL Providers",
        "focus": [
          "edge_proxy",
          "route_guard",
          "i18n_provider",
          "feature_view",
          "signalr_hub"
        ],
        "note": "Edge cookie verification (proxy.ts), client PBAC RouteGuard, UserFeatureGate, and EN/AR RTL hydration."
      },
      {
        "id": "crud_state_engine",
        "label": "3. @core/ui/* & Generic CRUD Engine",
        "focus": [
          "core_ui",
          "crud_engine",
          "feature_view",
          "viewmodel_hook",
          "query_zustand"
        ],
        "note": "100% @core/ui/* primitives, GenericCrudView, useCrudViewModel, TanStack Query v5, and Zustand store."
      },
      {
        "id": "single_flight_refresh",
        "label": "4. 401 Mutex & SignalR Real-Time Sync",
        "focus": [
          "viewmodel_hook",
          "api_service",
          "backend_api",
          "signalr_hub",
          "query_zustand"
        ],
        "note": "ApiService queues concurrent 401 requests behind a single-flight refresh mutex while SignalR pushes live domain events."
      }
    ]
