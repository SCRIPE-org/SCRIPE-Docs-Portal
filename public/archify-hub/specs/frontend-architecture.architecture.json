  "cards": [
    {
      "dot": "emerald",
      "title": "Strict 5-Layer SOLID MVVM Data Flow",
      "items": [
        "1. View renders @core/ui primitives and calls t('...') for bilingual copy.",
        "2. ViewModel Hook orchestrates UI state and TanStack Query without importing IApiService or DTOs.",
        "3. Repository maps backend wire DTOs into clean frontend Domain Entities; 4. Service calls 5. IApiService."
      ]
    },
    {
      "dot": "rose",
      "title": "Edge Guard, PBAC & Single-Flight 401 Mutex",
      "items": [
        "proxy.ts guards routes at the Next.js Edge; RouteGuard enforces PAGE_PERMISSIONS and Edition features.",
        "ApiService queues concurrent 401 responses in failedQueue while a single refresh token request executes."
      ]
    },
    {
      "dot": "cyan",
      "title": "Nexus Token System & 100% EN/AR Parity",
      "items": [
        "Surfaces map to --nx-ground, --nx-surface, and --nx-raised; flat matte cards use 1px border-nx-line.",
        "Signal Lime primary buttons always use dark ink text (text-nx-on-fill), never white text.",
        "All static strings live in co-located locales/*.en.ts and *.ar.ts dictionaries verified by scripe validate-locales."
      ]
    }
  ]
}