    {
      "dot": "rose",
      "title": "StudioConfirmExitDialog (z-960) & TenantRequired Guard",
      "items": [
        "Activates whenever inspectResult !== null and step !== 'results' (or ephemeralCredentials remain un-dismissed), keeping Step 3 -> Step 2 Back completely prompt-free.",
        "Intercepts Header Close (X), Escape, Step 2 -> Step 1 Back, and Replace File; DataTransferMenuProvider enforces RequiresTenantContext: true and DataExchangeTenantRequiredCard handles global Platform Super Admin navigation cleanly."
      ]
    },
    {
      "dot": "cyan",
      "title": "Outbox Event, Cooperative Cancel & Idiomatic Sileo ID-Morphing",
      "items": [
        "Terminal Completed / CompletedWithErrors commits publish DataExchangeJobCompletedEvent to datatransfer.outbox_messages and reconcile quota via ReconcileReservationLeaseAsync; no destructive post-completion global rollback job exists.",
        "Cooperative cancel (POST /jobs/{id}/cancel) invokes DetachPendingOutboxMessages() and releases unused slots, while id: 'dx-job-' + job.id morphs one Sileo toast pill across all states with localized entity display names."
      ]
    },
    {
      "dot": "emerald",
      "title": "7-Role [Authorize] PBAC, Quota Guard & Ephemeral Vault Protection",
      "items": [
        "DataTransferController uses [Authorize] + [PermissionRequired] across 7 standard roles (6 excluding CRM_SALES_REP for migrations.execute; no [AdminOnly]), returning DataTransfer.UnknownEntity (404) on invalid keys.",
        "Step 4 guards accidental modal dismissal until bulk Identity one-time onboarding credentials are downloaded or explicitly dismissed."
      ]
    }
