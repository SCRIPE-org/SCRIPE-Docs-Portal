  "cards": [
    {
      "dot": "rose",
      "title": "Cryptographic & Binding Invariants",
      "items": [
        "Encrypted IDs fail closed (422/404) via EncryptedGuidModelBinder and _idEncryption.TryDecrypt",
        "Subject-first (IdentityProviderId, ProviderKey) lookup blocks subject-swap takeover",
        "Auto-linking requires EmailVerified=true; legacy client-supplied link returns 410 Gone"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hybrid MFA & Cookie Delivery",
      "items": [
        "TrustIdpMfa or verified amr/acr skips duplicate TOTP; otherwise issues 5-min TwoFactorPendingToken",
        "CookieAuthMiddleware strips refreshToken from JSON bodies into HttpOnly scr_refresh_token",
        "UpdateLastLoginAtAsync persists via ExecuteUpdateAsync to avoid EF role-graph collisions"
      ]
    },
    {
      "dot": "violet",
      "title": "Post-Auth Runtime Gates",
      "items": [
        "PersonalAccessTokenAuthenticationHandler enforces pat_scope with no SystemProtected bypass",
        "TrustedCidrEnforcementMiddleware enforces AdminSecurityProfile CIDRs across every module",
        "ApiKeyUsageMiddleware enforces X-API-Key SHA-256, IpWhitelist, burst rate limits & usage logs"
      ]
    }
  ]
