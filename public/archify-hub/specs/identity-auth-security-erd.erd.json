  "cards": [
    {
      "dot": "cyan",
      "title": "Zero Plaintext Secrets Stored",
      "items": [
        "RefreshTokens automatically SHA-256 hex-hashes Token and ReplacedByToken inside IdentityDbContext.SaveChangesAsync.",
        "PasswordResetTokens stores a unique 64-char SHA-256 TokenHash (IX_PwdResetTok_Hash) alongside AllowedTenantIdsJson; Admins & Users store $s2$ hashes and Verification:VerifierKey HMAC verifiers."
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual Principal Isolation & Bounded Lifetimes",
      "items": [
        "Admins and Users retain separate DbSets and foreign keys on RefreshTokens and OtpCodes while sharing polymorphic PasswordHistories (PrincipalType, PrincipalId) and TenantSettings policy rules.",
        "Immutable AbsoluteExpiresAt ceilings prevent infinite refresh chaining across 24h standard, >=30d StaySignedIn, and 8h impersonation windows."
      ]
    }
  ]
