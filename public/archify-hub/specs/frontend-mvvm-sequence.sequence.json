  "cards": [
    {
      "dot": "emerald",
      "title": "Strict Layer Separation",
      "items": [
        "Views and ViewModels never import IApiService or wire DTOs.",
        "BookingRepository isolates the presentation layer from backend wire schema changes."
      ]
    },
    {
      "dot": "rose",
      "title": "Single-Flight 401 Mutex",
      "items": [
        "When an access token expires, only the first request calls /auth/refresh.",
        "Concurrent requests wait in failedQueue and replay automatically with their original X-Idempotency-Key."
      ]
    }
  ]
