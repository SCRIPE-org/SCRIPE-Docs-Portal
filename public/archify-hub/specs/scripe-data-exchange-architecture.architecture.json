  "cards": [
    {
      "dot": "rose",
      "title": "OWASP Gate & 17-Rule O(n) MENA Normalization Engine",
      "items": [
        "OwaspSpreadsheetSecurityValidator blocks macro archives, enforces ZIP ratio ceilings, neutralizes formula triggers, and marks CreatedAt/UpdatedAt as ExportOnly.",
        "SpreadsheetValueNormalizer runs 17 deterministic DataExchangeTransformRule options (N/A nulls, Tashkeel/Tatweel, accounting/Euro decimals, E.164 phones, DateFormat, SourceTimeZoneId) in O(n) with zero user regexes."
      ]
    },
    {
      "dot": "amber",
      "title": "5-Sheet CRM Topological DAG & Cross-Sheet Session Lookups",
      "items": [
        "DataExchangeOrchestrator.Execution.cs orders multi-sheet CRM workbooks topologically (crm.account -> crm.contact -> crm.lead -> crm.opportunity -> crm.activity) and resolves parent FKs via sessionResolvedKeys plus Email/Title/ExternalKey natural identifiers.",
        "Pass-2 self-FK links resolve intra-sheet hierarchies while invalid parent rows trigger cascade deferral and export into a downloadable rejected .xlsx workbook."
      ]
    },
    {
      "dot": "cyan",
      "title": "Worker Tenant Snapshot, Concurrency Cancel & Localized Notifications",
      "items": [
        "DataExchangeOrchestrator claims queued jobs via .IgnoreQueryFilters() (!IsDeleted) before entering DataExchangeAmbientContext.Begin(snapshot) with IsSuperAdmin clamped false.",
        "Concurrent POST /jobs/{id}/cancel races catch DbUpdateConcurrencyException, reload RowVersion, reconcile QuotaReservationLease, and emit human-readable DisplayNameEn notifications."
      ]
    },
    {
      "dot": "emerald",
      "title": "Portal Studio (z-900), Unified ⋯ CRUD Menus & Sileo Morphing",
      "items": [
        "DataExchangeStudioOverlay mounts via createPortal at z-[900] with StudioConfirmExitDialog (z-[960]), z-[950] error tooltips, and a context-smart scrollable ColumnNormalizationPopover.",
        "All 8 Admin, CRM, and Party views standardize on GenericCrudView getActions ⋯ dropdowns and flat matte Nexus CardGrid slabs, while sileo-toast morphs dx-job-{id} pills in place."
      ]
    }
  ]
