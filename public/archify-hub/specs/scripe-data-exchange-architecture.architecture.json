  "cards": [
    {
      "dot": "rose",
      "title": "OWASP Gate & Linear-Time O(n) MENA Normalization Engine",
      "items": [
        "OwaspSpreadsheetSecurityValidator blocks macro archives, enforces ZIP ratio ceilings, neutralizes formula triggers, and marks CreatedAt/UpdatedAt as ExportOnly.",
        "SpreadsheetValueNormalizer executes 17 deterministic DataExchangeTransformRule transforms (N/A nulls, Tashkeel/Tatweel, accounting/Euro numbers, E.164 phones, IANA timezones) with zero user regex."
      ]
    },
    {
      "dot": "cyan",
      "title": "Worker Tenant Snapshot & Concurrency Cancellation Safety",
      "items": [
        "DataExchangeOrchestrator loads queued worker jobs with .IgnoreQueryFilters() (!IsDeleted) before entering DataExchangeAmbientContext.Begin(snapshot).",
        "DataExchangeOrchestrator.Execution.cs catches DbUpdateConcurrencyException during concurrent POST /jobs/{id}/cancel races, reloads RowVersion, and reconciles quota holds."
      ]
    },
    {
      "dot": "emerald",
      "title": "Compact Toolbar, Normalization Popover & 3-Route Admin MVVM",
      "items": [
        "DataExchangeToolbarActions renders one @core/ui/dropdown-menu trigger inside CrmSectionHeader (hideToolbarActions: true in CRUD), eliminating filter bar overflow.",
        "The 3-route @modules/data-transfer module (/admin/data-exchange, /jobs, /presets) renders GenericCrudView<T> with Search/Status filtering and ColumnNormalizationPopover previews."
      ]
    },
    {
      "dot": "amber",
      "title": "3-Tab OpenXML Engine, 10 Providers & Ephemeral Onboarding Vault",
      "items": [
        "SpreadsheetStreamEngine embeds SHA-256 compatibility locks, Reference Lookups, and cf:* custom fields across 5 CRM, 3 PartyKernel, and 2 Identity providers.",
        "DataTransferImmediateWorker dispatches via Channel<Guid> (<50ms), DataExchangeFloatingDock polls every 2s, and bulk Identity imports return one-time passwords."
      ]
    }
  ]
