  "cards": [
    {
      "dot": "rose",
      "title": "Fail-Closed Security Ordering",
      "items": [
        "Every stage in MiddlewarePipeline.cs is strictly ordered so unauthenticated or replayed traffic never reaches controllers.",
        "Revoked JWTs are rejected immediately via Redis IAccountRevocationCache."
      ]
    },
    {
      "dot": "cyan",
      "title": "Tenant & PBAC Enforcement",
      "items": [
        "TenantContextValidation binds ICurrentUser.TenantId before PBAC policy evaluation.",
        "All rejections emit standardized RFC 7807 ProblemDetails with X-Correlation-ID."
      ]
    }
  ]
