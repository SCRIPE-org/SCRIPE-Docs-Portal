  "cards": [
    {
      "dot": "rose",
      "title": "TX-1 Autonomous Lease Claim",
      "items": [
        "TX-1 commits an InProgress receipt row before handler execution.",
        "Concurrent duplicate requests hit the unique index and receive 409 Conflict immediately."
      ]
    },
    {
      "dot": "emerald",
      "title": "TX-2 Atomic Domain + Outbox",
      "items": [
        "BaseDbContext extracts AggregateRoot.DomainEvents into schema-local outbox_messages in the same transaction.",
        "AuditLog diffs and UTC timestamps are stamped automatically."
      ]
    },
    {
      "dot": "cyan",
      "title": "TX-3 AES-GCM Receipt & L1 Replay",
      "items": [
        "Completed response payloads are encrypted with AES-GCM in idempotency_receipts and cached in Redis L1.",
        "Safe retries replay the exact Result<T> response without re-running business logic."
      ]
    }
  ]
