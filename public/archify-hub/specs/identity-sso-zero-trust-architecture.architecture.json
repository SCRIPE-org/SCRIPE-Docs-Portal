  "cards": [
    {
      "dot": "rose",
      "title": "Pre-Auth & Encrypted ID Laws",
      "items": [
        "Pre-auth lookups use .IgnoreQueryFilters() + explicit !IsDeleted, lockout & tenant status",
        "EncryptedGuidModelBinder & _idEncryption.TryDecrypt fail closed (422/404) — zero Guid.TryParse",
        "UpdateLastLoginAtAsync uses ExecuteUpdateAsync to prevent synthetic role-graph collisions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Federated SSO & Hybrid MFA",
      "items": [
        "Apple/MS/OIDC JWKS (MapInboundClaims=false), GitHub OAuth2 /user/emails, SAML X.509 + InResponseTo",
        "Subject-first (ProviderId, sub) lookup blocks subject-swap; auto-link requires EmailVerified=true",
        "HybridMfaPolicy issues 5-min TwoFactorPendingToken across OIDC, OAuth2, SAML, Magic Link & OTP"
      ]
    },
    {
      "dot": "violet",
      "title": "Live Runtime & Sudo Enforcement",
      "items": [
        "PAT scr_pat_... intersects pat_scope with zero SystemProtected bypass; X-API-Key enforces whitelist + burst",
        "TrustedCidrEnforcementMiddleware enforces AdminSecurityProfile CIDRs across every backend module",
        "AccountSecurityView uses live DB availableSsoProviders + Sudo initiate-link (legacy link 410 Gone)"
      ]
    }
  ]
