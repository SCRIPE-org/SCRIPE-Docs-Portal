  "cards": [
    {
      "dot": "emerald",
      "title": "Optimistic UI & Single-Flight Recovery",
      "items": [
        "onMutate snapshots the TanStack Query cache so the booking appears immediately in the schedule.",
        "If a 15m JWT expires mid-flight, the 401 Mutex refreshes the token and replays the mutation seamlessly."
      ]
    },
    {
      "dot": "rose",
      "title": "Deterministic Rollback on Conflict",
      "items": [
        "If the backend returns a 409 Conflict or 422 Validation Result, onError restores the exact cache snapshot.",
        "Live SignalR events notify the operator if a peer locks an overlapping slot."
      ]
    }
  ]
