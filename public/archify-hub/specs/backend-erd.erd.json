  "cards": [
    {
      "dot": "cyan",
      "title": "Strict Schema Isolation",
      "items": [
        "Every module owns its isolated schema (identity.*, venue.*, catalog_pricing.*, finance.*, crm.*).",
        "Physical foreign keys exist only within the same module schema."
      ]
    },
    {
      "dot": "amber",
      "title": "Logical Cross-Module References",
      "items": [
        "Cross-module relationships (dashed) use logical UUID columns without physical DB foreign keys.",
        "This allows Mode 2 to split any module onto its own physical database server with zero schema changes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Per-Schema Outbox & Receipts",
      "items": [
        "Every module schema migrates its own outbox_messages, inbox_messages, and idempotency_receipts tables.",
        "Domain state, audit logs, and outbox events commit in a single ACID transaction."
      ]
    }
  ]
}