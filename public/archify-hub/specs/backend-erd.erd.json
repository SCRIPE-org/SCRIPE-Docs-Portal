    "views": [
      {
        "id": "identity_venue",
        "label": "1. Identity & Venue Core",
        "focus": [
          "identity_tenants",
          "identity_users",
          "venue_resources",
          "venue_reservations"
        ],
        "note": "Tenant and user roots in identity.* linked logically to schedulable resources and reservations in venue.*."
      },
      {
        "id": "commercial_settlement",
        "label": "2. Pricing, Finance & CRM",
        "focus": [
          "venue_reservations",
          "pricing_quotes",
          "finance_invoices",
          "crm_opportunities"
        ],
        "note": "Commercial quote snapshots in catalog_pricing.* link logically to reservations, invoices, and CRM opportunities."
      },
      {
        "id": "outbox_idempotency",
        "label": "3. Per-Schema Outbox & Receipts",
        "focus": [
          "venue_reservations",
          "pricing_quotes",
          "module_outbox",
          "module_receipts"
        ],
        "note": "Every module schema owns dedicated outbox_messages and idempotency_receipts tables committed in the same transaction."
      }
    ]
  },
