  "cards": [
    {
      "dot": "rose",
      "title": "5-Layer Defense & 29-Stage HTTP Pipeline",
      "items": [
        "MiddlewarePipeline enforces strict ordering: ForwardedHeaders -> GlobalException -> SecurityHeaders -> CorrelationId -> OTel -> CORS -> Cloudflare Origin -> RateLimiting.",
        "Auth & mutation defense: CookieAuth -> JwtBearer (fail-closed IAccountRevocationCache) -> CsrfProtection -> InputSanitization -> PBAC Authorization -> ReplayProtection -> TenantContextValidation."
      ]
    },
    {
      "dot": "cyan",
      "title": "AstraFlow 2.3.0 Total Ecosystem Lock",
      "items": [
        "Ordered mediator pipeline: LoggingBehavior -> ValidationBehavior -> IdempotencyBehavior -> AuthorizationBehavior -> CachingBehavior -> PerformanceBehavior.",
        "ScripeSecureIdCodec & [AstraGenerateMapping] encrypt internal Guid keys at the DTO boundary and provide zero-allocation compile-time mappings."
      ]
    },
    {
      "dot": "emerald",
      "title": "18 Sovereign Modules & Fail-Closed DI",
      "items": [
        "Modules follow strict Domain / Application / Infrastructure boundaries with zero cross-module foreign keys.",
        "ModuleRegistration validates cross-module contract dependencies at startup so server-role splits fail fast at boot."
      ]
    },
    {
      "dot": "amber",
      "title": "Dual-Mode Multi-DB & Transactional Outbox",
      "items": [
        "AddModuleMultiProviderDatabase resolves SqlServer, Oracle, or PostgreSQL DbContexts per module in Single-DB or Multi-DB mode.",
        "SaveChangesAsync atomically captures aggregate domain events into schema-local outbox_messages alongside 3-transaction idempotency_receipts."
      ]
    }
  ]
}