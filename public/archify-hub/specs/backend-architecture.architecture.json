        "id": "astraflow_cqrs",
        "label": "2. AstraFlow 2.3 CQRS Pipeline",
        "focus": [
          "controllers",
          "mediator",
          "redis_cache",
          "handlers",
          "pricing_engine"
        ],
        "note": "AstraFlow v2.3.0 mediator runs Logging, Validation, Idempotency (3-TX), Authorization, Caching, and compile-time mappers."
      },
      {
        "id": "persistence_outbox",
        "label": "3. Dual-Mode DB & Transactional Outbox",
        "focus": [
          "handlers",
          "pricing_engine",
          "base_dbcontext",
          "module_db",
          "outbox_processor",
          "event_bus",
          "mediator"
        ],
        "note": "BaseDbContext commits domain rows, outbox_messages, and idempotency_receipts atomically per module schema across PG, SQL Server & Oracle."
      },
      {
        "id": "cross_module_contracts",
        "label": "4. Cross-Module Contracts & Event Bus",
        "focus": [
          "handlers",
          "pricing_engine",
          "event_bus",
          "outbox_processor",
          "mediator"
        ],
        "note": "Synchronous reads use Contracts interfaces (ICatalogPricingCalculationService); asynchronous updates flow via Outbox & Inbox."
      }
