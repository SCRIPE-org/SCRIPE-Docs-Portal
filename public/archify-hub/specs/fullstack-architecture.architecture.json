  "cards": [
    {
      "dot": "emerald",
      "title": "Symmetrical Full-Stack Invariants",
      "items": [
        "Frontend enforces 5-layer SOLID MVVM (View -> ViewModel -> Repository -> Service -> IApiService) with 100% @core/ui/* primitives.",
        "Backend enforces 3-project Clean Architecture (Domain, Application, Infrastructure) across 18 schema-isolated modules.",
        "Both tiers forbid raw exceptions on business paths, communicating via structured Result<T> envelopes."
      ]
    },
    {
      "dot": "rose",
      "title": "5-Layer Zero-Trust Security",
      "items": [
        "Edge proxy.ts and client RouteGuard validate cookies, PAGE_PERMISSIONS, and Edition entitlements before hydration.",
        "ApiService queues concurrent 401 calls behind a single-flight refresh mutex and injects X-Idempotency-Key.",
        "Backend 29-stage MiddlewarePipeline enforces JWT revocation, CSRF, replay nonces, PBAC, and BaseDbContext TenantId filters."
      ]
    },
    {
      "dot": "cyan",
      "title": "Transactional Outbox & CLI Governance",
      "items": [
        "BaseDbContext commits entity changes, AuditLog diffs, and outbox_messages in one atomic database transaction.",
        "OutboxProcessorJob dispatches integration events and real-time SignalR notifications to connected React clients.",
        "scripe-cli (193 commands) enforces 0 architectural violations via scripe arch-check and scripe check."
      ]
    }
  ]
