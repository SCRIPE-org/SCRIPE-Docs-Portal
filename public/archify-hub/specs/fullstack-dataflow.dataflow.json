  "cards": [
    {
      "dot": "emerald",
      "title": "Zero-Allocation Read & Write Lineage",
      "items": [
        "Commands move through 29-stage ingress and AstraFlow 3-TX validation into isolated module schemas.",
        "Read queries use AsNoTracking() and AstraFlow ProjectTo with page sizes strictly guarded to <= 100."
      ]
    },
    {
      "dot": "rose",
      "title": "Field-Level Security & AES-GCM",
      "items": [
        "Sensitive PII fields are encrypted with AES-GCM before hitting disk and redacted on egress via AstraFlow.Security.",
        "Internal GUIDs are wrapped at the API boundary using ScripeSecureIdCodec."
      ]
    },
    {
      "dot": "orange",
      "title": "Transactional Outbox Consumers",
      "items": [
        "Domain events are captured atomically into {module}.outbox_messages during SaveChangesAsync.",
        "OutboxProcessor feeds both internal analytics projections and live SignalR WebSocket streams."
      ]
    }
  ]
