  "cards": [
    {
      "dot": "violet",
      "title": "Multi-Role FLS Algebra",
      "items": [
        "Within each role: union RestrictedFieldsJson across permissions of the same resource",
        "Across roles: intersect read-capable roles (so Manager + Rep unmasks Manager)",
        "Across UserGroups: union UserGroupRestrictions on top (cannot be bypassed by role)"
      ]
    },
    {
      "dot": "rose",
      "title": "Write & Export Parity",
      "items": [
        "UpdateOpportunityCommandHandler blocks modified restricted non-nullable fields (0m/SAR)",
        "Dashboard & Audit exports require audit.export + AuditExportRedactionHelper",
        "Compliance CSV uses CsvFormulaGuard.Neutralize & rejects open Redirect(FileUrl)"
      ]
    }
  ]
