  "cards": [
    {
      "dot": "emerald",
      "title": "5-Layer MVVM Client Discipline",
      "items": [
        "BookingView triggers the ViewModel hook without importing DTOs or HTTP services.",
        "ApiService attaches X-Tenant-Id and X-Idempotency-Key automatically.",
        "Single-flight 401 refresh mutex prevents token refresh storms across concurrent widgets."
      ]
    },
    {
      "dot": "rose",
      "title": "3-TX Idempotency & Security",
      "items": [
        "MiddlewarePipeline validates JWT revocation, CSRF, replay nonce, and PBAC before controller entry.",
        "TX-1 claims the idempotency key; TX-2 commits domain rows and outbox_messages; TX-3 seals the encrypted receipt."
      ]
    },
    {
      "dot": "orange",
      "title": "Asynchronous Outbox & SignalR",
      "items": [
        "Outbox polling is decoupled from the synchronous HTTP response path.",
        "SignalR pushes real-time calendar updates to all connected operators in the tenant."
      ]
    }
  ]
